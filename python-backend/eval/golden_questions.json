[
  {
    "id": "readme-top10-distance-wc",
    "query": "Top 10 players by total distance in the World Cup",
    "expect": {
      "metric": "total_distance",
      "ranking": "top",
      "requested_limit": 10,
      "filter_fields": ["competition"],
      "sql_contains": ["ORDER BY metric_value DESC", "s.competition ILIKE %s"]
    }
  },
  {
    "id": "readme-position-pressures",
    "query": "Which position had the most pressures in the World Cup?",
    "expect": {
      "metric": "pressures",
      "grouping": "position",
      "sql_contains": ["GROUP BY a.position"],
      "sql_not_contains": ["athlete_name"]
    }
  },
  {
    "id": "readme-nfl-wr-sprint",
    "query": "Top 5 NFL wide receivers by sprint distance",
    "expect": {
      "metric": "sprint_distance",
      "requested_limit": 5,
      "filter_fields": ["sport", "position"],
      "forbidden_filter_fields": ["nationality"]
    }
  },
  {
    "id": "readme-avg-passes-position-soccer",
    "query": "Average passes per position in soccer",
    "expect": {
      "metric": "passes",
      "grouping": "position",
      "aggregation": "avg",
      "no_time_window": true,
      "filter_fields": ["sport"]
    }
  },
  {
    "id": "readme-argentine-distance",
    "query": "Top 5 Argentine players by total distance",
    "expect": {
      "metric": "total_distance",
      "requested_limit": 5,
      "filter_value": {"field": "nationality", "value": "Argentina"}
    }
  },
  {
    "id": "readme-nfl-position-speed",
    "query": "Which NFL position averages the highest speed?",
    "expect": {
      "metric": "avg_speed",
      "grouping": "position",
      "sql_contains": ["GROUP BY a.position", "g.avg_speed IS NOT NULL"]
    }
  },
  {
    "id": "readme-nationality-shots",
    "query": "Which nationality scored the most shots?",
    "expect": {
      "metric": "shots",
      "grouping": "nationality",
      "sql_contains": ["GROUP BY a.nationality"]
    }
  },
  {
    "id": "readme-compare-sports",
    "query": "Compare total distance between soccer and american football",
    "expect": {
      "metric": "total_distance",
      "grouping": "sport",
